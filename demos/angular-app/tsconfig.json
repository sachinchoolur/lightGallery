{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "types": [
      "vite/client"
    ]
  },
  "angularCompilerOptions": {
    "strictTemplates": true
  },
  "include": [
    "src",
    "../shared"
  ]
}
