---
/**
 * TEMPORARY design exploration: the "Trusted by" strip in alternative
 * layouts, one full section each, under the live one. The logos and their
 * sizing live in data/customer-logos, the base logo rules in
 * `components/_customer-logo.scss`. Remove this component (and
 * `pages/_home-trusted-variants.scss`) once a layout is chosen.
 *
 * Every remaining variant is two rows of cells that swap their logo in
 * place; only the effect differs. Desktop has 2 x 5 cells showing three
 * logos each, phones 2 x 3 showing five, so all 30 appear at either size;
 * cell c holds every `cells`-th logo, so the first frame is the
 * top-ranked brands. Each effect's delay (from the cell's column and row)
 * shapes the wave: a ripple or a diagonal.
 */
import CustomerLogo from '../CustomerLogo.astro';
import { LOGOS } from '../../data/customer-logos';

const HEADING = "Trusted by the world's top brands.";

const SWAP_LAYOUTS = [
    { cls: 'tb-swap-wide', cols: 5, cells: 10 },
    { cls: 'tb-swap-narrow', cols: 3, cells: 6 },
];
type Delay = (col: number, row: number) => number;
const DELAYS: Record<string, Delay> = {
    cycle: (col, row) => col * 0.18 + row * 0.09,
    flip: (col, row) => (col + row) * 0.12,
    blur: (col, row) => (col + row) * 0.06,
    drop: (col, row) => (col + row) * 0.08,
    turn: (col, row) => (col + row) * 0.1,
    swipe: (col, row) => col * 0.04 + row * 0.1,
};
const swapCells = (cells: number) =>
    Array.from({ length: cells }, (_, c) => LOGOS.filter((_, i) => i % cells === c));
const swapDelay = (key: string, c: number, cols: number) =>
    +DELAYS[key](c % cols, Math.floor(c / cols)).toFixed(2);

// Pruned to the user's shortlist; each keeps its original number.
const TOTAL = 32;
const VARIANTS = [
    { n: 9, key: 'cycle', name: 'Two rows, cycling' },
    { n: 17, key: 'flip', name: 'Two rows, flip' },
    { n: 18, key: 'blur', name: 'Two rows, blur swap' },
    { n: 25, key: 'drop', name: 'Two rows, drop in' },
    { n: 28, key: 'turn', name: 'Two rows, card turn' },
    { n: 29, key: 'swipe', name: 'Two rows, swipe' },
] as const;
---

{VARIANTS.map((variant) => (
    <div class={`container-xl trusted-by tb-section tb-var-${variant.key}`} id={`trusted-v${variant.n}`}>
        <div class="fv-label">Variation {variant.n} of {TOTAL} · {variant.name}</div>
        <p class="tb-label">{HEADING}</p>
        {SWAP_LAYOUTS.map((layout) => (
            <div
                class={`tb-swap tb-swap-${variant.key} ${layout.cls}`}
                style={`--cols:${layout.cols};--n:${LOGOS.length / layout.cells};--slot:2.6s`}
            >
                {swapCells(layout.cells).map((cell, c) => (
                    <span class="tb-swap-cell" style={`--d:${swapDelay(variant.key, c, layout.cols)}s`}>
                        {cell.map((l, i) => (
                            <span class="tb-swap-slot" style={`--i:${i}`}>
                                <CustomerLogo logo={l} />
                            </span>
                        ))}
                    </span>
                ))}
            </div>
        ))}
    </div>
))}
