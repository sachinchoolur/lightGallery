---
/**
 * Feature icons for the homepage, original line artwork drawn on a
 * 24px grid, one per feature, in the same thin-stroke style as the
 * custom-icons demo set. `currentColor` so the wrapper decides the tint.
 */
interface Props {
    name: keyof typeof ICONS;
    class?: string;
}

const ICONS = {
    thumbnails: '<rect x="3.5" y="4.5" width="17" height="11" rx="1.5"/><rect x="3.5" y="18" width="3.5" height="2.5" rx=".6"/><rect x="8.5" y="18" width="3.5" height="2.5" rx=".6"/><rect x="13.5" y="18" width="3.5" height="2.5" rx=".6"/><rect x="18.5" y="18" width="2" height="2.5" rx=".6"/>',
    zoom: '<circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5L20 20M8 10.5h5M10.5 8v5"/>',
    video: '<rect x="3.5" y="5" width="17" height="14" rx="2"/><path d="M10.5 9.5v5l4-2.5z"/>',
    justified: '<rect x="3.5" y="4.5" width="7" height="6" rx="1"/><rect x="12.5" y="4.5" width="8" height="6" rx="1"/><rect x="3.5" y="13" width="10" height="6.5" rx="1"/><rect x="15.5" y="13" width="5" height="6.5" rx="1"/>',
    virtualization: '<rect x="7" y="7" width="10" height="10" rx="1.5"/><path d="M3.5 9.5v5M20.5 9.5v5M9.5 3.5h5M9.5 20.5h5"/>',
    scrubbing: '<path d="M3.5 12h17"/><rect x="9" y="8" width="6" height="8" rx="1.5"/><path d="M4.5 7.5v9M19.5 7.5v9"/>',
    icons: '<path d="M12 3.5l1.8 4.4 4.7.4-3.6 3.1 1.1 4.6L12 13.6 8 16l1.1-4.6-3.6-3.1 4.7-.4z"/>',
    localization: '<circle cx="12" cy="12" r="8.5"/><path d="M3.5 12h17M12 3.5c2.6 2.6 2.6 14.4 0 17M12 3.5c-2.6 2.6-2.6 14.4 0 17"/>',
    accessibility: '<circle cx="12" cy="5" r="1.6"/><path d="M4.5 9.5c5 1 10 1 15 0M12 10.5v4.5M12 15l-3 5.5M12 15l3 5.5"/>',
    responsive: '<rect x="3.5" y="5" width="12" height="9" rx="1.5"/><rect x="15.5" y="10" width="5" height="9" rx="1.2"/><path d="M7 17.5h5"/>',
    sharing: '<circle cx="6" cy="12" r="2.3"/><circle cx="17.5" cy="6" r="2.3"/><circle cx="17.5" cy="18" r="2.3"/><path d="M8.1 10.9l7.3-3.8M8.1 13.1l7.3 3.8"/>',
    links: '<path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1.2 1.2"/><path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1.2-1.2"/>',
    dynamic: '<path d="M8.5 4.5c-2 0-3 1-3 3v2.5c0 1-.5 2-2 2 1.5 0 2 1 2 2v2.5c0 2 1 3 3 3M15.5 4.5c2 0 3 1 3 3v2.5c0 1 .5 2 2 2-1.5 0-2 1-2 2v2.5c0 2-1 3-3 3"/>',
    updates: '<path d="M19.5 12a7.5 7.5 0 0 1-13 5.1M4.5 12a7.5 7.5 0 0 1 13-5.1"/><path d="M17 3.5v3.5h-3.5M7 20.5V17h3.5"/>',
    transitions: '<rect x="3.5" y="6" width="10" height="12" rx="1.5"/><path d="M13.5 9h5a2 2 0 0 1 2 2v7M17 15l3.5 3-3.5 3"/>',
    captions: '<rect x="3.5" y="4.5" width="17" height="15" rx="1.5"/><path d="M7 14.5h6M7 11h10"/>',
    comments: '<path d="M4.5 6.5a2 2 0 0 1 2-2h11a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2h-7l-4.5 3.5V15.5h-.5a2 2 0 0 1-2-2z"/>',
    rotate: '<path d="M6.5 8.5a7 7 0 1 1-1.5 6"/><path d="M4.5 4.5v4.5H9"/>',
    autoplay: '<circle cx="12" cy="12" r="8.5"/><path d="M10 8.5v7l5.5-3.5z"/>',
    pagers: '<circle cx="6" cy="12" r="1.6"/><circle cx="12" cy="12" r="2.4"/><circle cx="18" cy="12" r="1.6"/>',
} as const;

const { name, class: className } = Astro.props;
---

<span class={`feature-icon ${className ?? ''}`} aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS[name]} />
</span>
