---
/**
 * Proof-in-numbers strip: GitHub stars and weekly npm downloads are
 * fetched once at build time (static site — no client requests), with
 * last-known values as fallbacks so an offline or rate-limited build
 * still renders sensible numbers. Bundle size is measured from the
 * workspace build the site already consumes.
 */
import { gzipSync } from 'node:zlib';
import { readFileSync } from 'node:fs';
import { createRequire } from 'node:module';
import { dirname, join } from 'node:path';

const FALLBACK_STARS = 7000;
const FALLBACK_WEEKLY_DOWNLOADS = 100000;
const FIRST_RELEASE_YEAR = 2014;

async function fetchJson(url: string): Promise<any | null> {
    try {
        const response = await fetch(url, {
            signal: AbortSignal.timeout(6000),
            headers: { accept: 'application/json' },
        });
        return response.ok ? await response.json() : null;
    } catch {
        return null;
    }
}

const [repo, downloads] = await Promise.all([
    fetchJson('https://api.github.com/repos/sachinchoolur/lightGallery'),
    fetchJson('https://api.npmjs.org/downloads/point/last-week/lightgallery'),
]);

const stars: number = repo?.stargazers_count ?? FALLBACK_STARS;
const weekly: number = downloads?.downloads ?? FALLBACK_WEEKLY_DOWNLOADS;

let coreGzipKb = 16;
try {
    // The workspace package resolves to the repo root; the built
    // browser bundle lives under its `dist/`.
    const require = createRequire(import.meta.url);
    const root = dirname(require.resolve('lightgallery/package.json'));
    const bundle = readFileSync(join(root, 'dist/lightgallery.min.js'));
    coreGzipKb = Math.round(gzipSync(bundle).length / 1024);
} catch {
    /* keep the last measured value */
}

const compact = new Intl.NumberFormat('en', {
    notation: 'compact',
    maximumFractionDigits: 1,
});
const years = new Date().getFullYear() - FIRST_RELEASE_YEAR;

const stats = [
    { value: compact.format(weekly), label: 'npm downloads a week' },
    { value: compact.format(stars), label: 'GitHub stars' },
    { value: `${years}+ yrs`, label: 'in active maintenance' },
    { value: `${coreGzipKb} KB`, label: 'core, minified + gzipped' },
    { value: '0', label: 'dependencies' },
];
---

<div class="container-xl home-numbers" aria-label="lightGallery by the numbers">
    <ul class="home-numbers-list">
        {
            stats.map((stat) => (
                <li class="home-numbers-item">
                    <span class="home-numbers-value">{stat.value}</span>
                    <span class="home-numbers-label">{stat.label}</span>
                </li>
            ))
        }
    </ul>
</div>
