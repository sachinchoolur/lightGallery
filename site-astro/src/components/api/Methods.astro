---
import { Code } from 'astro:components';

import { publicMethods, tagText } from '../../lib/apidocs';
import DetailTable from './DetailTable.astro';

/** Public method docs, port of `shortcodes/methods.html`. */
const methods = publicMethods();
---

<div class="docs-methods-section">
    {
        methods.map((method) => (
            <section class="api-entry">
                <h3 class="api-entry-name" id={method.name}>
                    <code>{method.signature}</code>{' '}
                    <a
                        href={`#${method.name}`}
                        class="anchor"
                        aria-hidden="true"
                    >
                        #
                    </a>
                </h3>
                <p class="api-entry-desc">{method.comment.summary}</p>
                {tagText(method.comment, 'description').map((text) => (
                    <p class="api-entry-desc" set:html={text} />
                ))}
                {method.params.length > 0 && (
                    <div class="api-entry-block">
                        <span class="api-entry-label">Parameters</span>
                        <DetailTable props={method.params} />
                    </div>
                )}
                {tagText(method.comment, 'example').map((example) => (
                    <div class="api-entry-block">
                        <span class="api-entry-label">Example</span>
                        <Code code={example.trim()} lang="js" />
                    </div>
                ))}
                {tagText(method.comment, 'note').map((note) => (
                    <p class="alert alert-info" role="alert">
                        <span>
                            <b>Note.</b> <Fragment set:html={note} />
                        </span>
                    </p>
                ))}
                {tagText(method.comment, 'see').map((text) => (
                    <p class="api-entry-meta">
                        <span class="api-entry-label">See also</span>
                        <Fragment set:html={text} />
                    </p>
                ))}
            </section>
        ))
    }
</div>
