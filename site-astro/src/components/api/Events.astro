---
import { Code } from 'astro:components';

import {
    commentOf,
    findReflection,
    interfaceProps,
    tagText,
} from '../../lib/apidocs';
import DetailTable from './DetailTable.astro';

/** Event doc block, port of `shortcodes/events.html`. */
interface Props {
    interface: string;
}

const { interface: interfaceName } = Astro.props;
const meta = commentOf(findReflection(interfaceName));
const detail = interfaceProps(interfaceName);
const names = tagText(meta, 'name');
const examples = tagText(meta, 'example');
const seeAlso = tagText(meta, 'see');
---

<section class="api-entry">
    {
        names.map((name) => (
            <h3 class="api-entry-name" id={name}>
                <code>{name}</code>{' '}
                <a href={`#${name}`} class="anchor" aria-hidden="true">
                    #
                </a>
            </h3>
        ))
    }
    <p class="api-entry-desc">{meta.summary}</p>
    {
        detail.length > 0 && (
            <div class="api-entry-block">
                <span class="api-entry-label">Event detail</span>
                <DetailTable props={detail} />
            </div>
        )
    }
    {
        examples.map((example) => (
            <div class="api-entry-block">
                <span class="api-entry-label">Example</span>
                <Code code={example.trim()} lang="js" />
            </div>
        ))
    }
    {
        seeAlso.map((text) => (
            <p class="api-entry-meta">
                <span class="api-entry-label">See also</span>
                <Fragment set:html={text} />
            </p>
        ))
    }
</section>
