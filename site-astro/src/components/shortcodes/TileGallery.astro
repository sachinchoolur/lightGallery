---
/**
 * Square tile grid for the cropped-thumbnails demo. Every tile crops its
 * photo with `object-fit: cover`, portrait and landscape alike, and the
 * tiles take turns at an `object-position`, so a flight that follows the
 * crop can be told from one that flies the whole photo.
 */
import { photos as pick } from '../../lib/photos';

interface Props {
    id: string;
    photos?: string;
    limit?: number;
}
const { id, limit = 8 } = Astro.props;
const items = pick(Astro.props.photos ?? 'morocco', limit);

// The part of the photo each tile shows, in turn.
const POSITIONS = ['50% 50%', '50% 0%', '100% 50%', '50% 100%', '0% 50%'];
---
<div class="gallery-demo-tiles">
    <div id={id}>
        {items.map((p, i) => (
            <a
                class="gallery-item"
                href={p.src}
                data-src={p.src}
                data-lg-size={p.size}
                data-responsive={p.responsive}
                data-sub-html={p.caption}
                data-pinterest-text={p.title}
                data-tweet-text={`lightGallery slide ${i + 1}`}
            >
                <img
                    alt={p.alt}
                    src={p.thumb}
                    style={`object-position: ${POSITIONS[i % POSITIONS.length]}`}
                />
            </a>
        ))}
    </div>
</div>

<script>
    import '../../scripts/demo-galleries.js';
</script>
