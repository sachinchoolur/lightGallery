---
/** Captions demo; the wrapper class drives the animated caption styles. */
import { photos as pick } from '../../lib/photos';

interface Props {
    id: string;
    photos?: string;
    limit?: number;
}
const { id, limit = 6 } = Astro.props;
const items = pick(Astro.props.photos ?? 'alley', limit);
---
<div class="gallery-demo-sm">
    <div id={id} class="list-unstyled">
        {items.map((p, i) => (
            <a
                data-lg-size={p.size}
                data-pinterest-text={`Pin it ${i + 1}`}
                data-src={p.src}
                data-responsive={p.responsive}
                data-sub-html={`<div class='lightGallery-captions'>${p.caption}</div>`}
            >
                <img class="img-responsive" alt={p.alt} src={p.thumb} />
            </a>
        ))}
    </div>
</div>

<script>
    import '../../scripts/demo-galleries.js';
</script>
