---
interface Props {
    id: string;
}
const { id } = Astro.props;
---
<div class="gallery-demo-videos">
    <div id={id} class="list-unstyled">
        <a
            data-lg-size="1600-2400"
            data-pinterest-text="Pin it2"
            data-tweet-text="lightGallery slide 2"
            data-slide-name="Bowness-bay"
            data-reddit-title="Bowness Bay"
            data-src="https://images.unsplash.com/photo-1608481337062-4093bf3ed404?ixlib=rb-1.2.1&ixid=MXwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHw%3D&auto=format&fit=crop&w=1600&q=80"
            data-sub-html="<h4>Photo by - <a href='https://unsplash.com/@therawhunter' >Massimiliano Morosinotto </a></h4><p> Location - <a href='https://unsplash.com/s/photos/tre-cime-di-lavaredo%2C-italia'>Tre Cime di Lavaredo, Italia</a>This is the Way</p>"
        >
            <img
                class="img-responsive"
                src="https://images.unsplash.com/photo-1608481337062-4093bf3ed404?ixlib=rb-1.2.1&ixid=MXwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHw%3D&auto=format&fit=crop&w=240&q=80"
            />
        </a>
        <a
            data-lg-size="1280-720"
            data-pinterest-text="Pin it3"
            data-tweet-text="lightGallery slide 4"
            data-src="//www.youtube.com/watch?v=EIUJfXk3_3w"
            data-poster="https://img.youtube.com/vi/EIUJfXk3_3w/maxresdefault.jpg"
            data-sub-html="<h4>Puffin Hunts Fish To Feed Puffling | Blue Planet II | BBC Earth</h4><p>This puffin parent must go out to sea to feed his chick, but he must evade other birds that would rob him.</p>"
        >
            <img
                width="480"
                height="270"
                class="img-responsive"
                src="https://img.youtube.com/vi/EIUJfXk3_3w/mqdefault.jpg"
            />
        </a>
        <a
            data-lg-size="1280-720"
            data-pinterest-text="Pin it3"
            data-tweet-text="lightGallery slide 4"
            data-src="//vimeo.com/112836958"
            data-poster="/images/demo/vimeo-video-poster.jpg"
            data-sub-html="<h4>Nature</h4><p>Video by <a target='_blank' href='https://vimeo.com/charliekaye'>Charlie Kaye</a></p>"
        >
            <img
                width="480"
                height="270"
                class="img-responsive"
                src="/images/demo/vimeo-video-poster-480.jpg"
            />
        </a>
        <a
            data-lg-size="1280-720"
            data-pinterest-text="Pin it3"
            data-tweet-text="lightGallery slide 4"
            data-src="https://private-sharing.wistia.com/medias/mwhrulrucj"
            data-poster="/images/demo/wistia-video-poster.jpeg"
            data-sub-html="<h4>Thank You!</h4><p> Sample Wistia video </p>"
        >
            <img
                width="480"
                height="270"
                class="img-responsive"
                src="/images/demo/wistia-video-poster-480.jpeg"
            />
        </a>
        <a
            data-lg-size="1280-720"
            data-pinterest-text="Pin it3"
            data-tweet-text="lightGallery slide 4"
            data-video='{"source": [{"src":"/videos/video1.mp4", "type":"video/mp4"}], "attributes": {"preload": false, "controls": true}}'
            data-poster="/images/demo/html5-video-poster.jpg"
            data-sub-html="<h4>'Peck Pocketed' by Kevin Herron | Disney Favorite</h4>"
        >
            <img
                width="480"
                height="270"
                class="img-responsive"
                src="/images/demo/html5-video-poster-480.jpg"
            />
        </a>
    </div>
</div>

<script>
    import '../../scripts/demo-galleries.js';
</script>
