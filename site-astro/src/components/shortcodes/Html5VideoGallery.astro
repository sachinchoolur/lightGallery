---
interface Props {
    id: string;
}
const { id } = Astro.props;
---
<div class="gallery-demo-videos">
    <div id={id} class="list-unstyled">
        <a
            data-lg-size="1280-720"
            data-pinterest-text="Pin it3"
            data-tweet-text="lightGallery slide  4"
            data-video='{"source": [{"src":"/videos/video1.mp4", "type":"video/mp4"}], "tracks": [{"src": "/videos/title.txt", "kind":"captions", "srclang": "en", "label": "English", "default": "true"}], "attributes": {"preload": false, "controls": true}}'
            data-poster="/images/demo/html5-video-poster.jpg"
            data-sub-html="<h4>'Peck Pocketed' by Kevin Herron | Disney Favorite</h4>"
        >
            <img
                width="480"
                height="270"
                class="img-responsive"
                src="/images/demo/html5-video-poster-480.jpg"
            />
        </a>
        <a
            data-lg-size="1280-720"
            data-pinterest-text="Pin it3"
            data-tweet-text="lightGallery slide  4"
            data-video='{"source": [{"src":"/videos/video2.mp4", "type":"video/mp4"}], "attributes": {"preload": false, "controls": true}}'
            data-poster="/images/demo/html5-video-poster-2.jpg"
            data-sub-html="<h4>ROLLIN' SAFARI - 'Meerkats' - what if animals were round?</h4>"
        >
            <img
                width="480"
                height="270"
                class="img-responsive"
                src="/images/demo/html5-video-poster-2-480.jpg"
            />
        </a>
    </div>
</div>

<script>
    import '../../scripts/demo-galleries.js';
</script>
