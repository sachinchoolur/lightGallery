---
/**
 * License page plans: the title, the three commercial plans as columns of
 * one card, the Extended license as the card's footer row, and a note for
 * v1 and v2 license holders. One-time payments only. The card is a React
 * island so each amount can come from Kelviq's localized pricing for the
 * visitor's country; the plan copy lives here and goes in as props. Above
 * the card, a second small island shows the Kelviq promotion banner for
 * countries that have one.
 */
import LicensePlans, { type Plan } from '../islands/LicensePlans';
import PromoBanner from '../islands/PromoBanner';

const TITLE = 'Pricing and commercial license';
const LEAD =
    'lightGallery is free and open source under the GPLv3. The commercial license is for projects that keep their source proprietary: same code, every plugin, one-time payment.';
const PLANS: Plan[] = [
    { key: 'hobby', name: 'Hobby', desc: 'For personal use.', price: 48, terms: ['For <b>one</b> developer', 'For <b>one</b> product', "Can't be used in a product for sale", 'GitHub support only'] },
    { key: 'team', name: 'Team', desc: 'For small teams.', price: 118, terms: ['For up to <b>8</b> developers', 'For up to <b>5</b> products', 'Can be used in a product for sale', 'GitHub and email support'], featured: true },
    { key: 'organization', name: 'Organization', desc: 'For large teams and organizations', price: 188, terms: ['For <b>unlimited</b> developers', 'For <b>unlimited</b> products', 'Can be used in a product for sale', 'GitHub, Email and Skype support'] },
];
const EXT_TITLE = 'Extended Commercial license';
const EXT_DESC =
    'If you want to include lightGallery as part of software developer kit (SDK), web application builder or website builder, downloadable or installable products like Wordpress themes, HTML templates,or something that produces copies that each use lightGallery, you need to choose the Extended Commercial license.';
const EMAIL = 'contact@lightgalleryjs.com';
const EXTENDED: Plan = { key: 'extended', name: 'Extended', desc: EXT_DESC, price: 239, terms: ['For <b>unlimited</b> developers', 'For <b>one</b> product'] };
---

<div class="license-section" id="plans">
    <div class="license-inner">
        <div class="plans-head">
            <h1 class="plans-title">{TITLE}</h1>
            <p class="plans-lead">{LEAD}</p>
        </div>

        <div class="plans-promo"><PromoBanner client:idle /></div>

        <LicensePlans client:load plans={PLANS} extended={EXTENDED} extTitle={EXT_TITLE} />

        <div class="plans-upgrade">
            <h2 class="plans-upgrade-title">Upgrading from v1 or v2</h2>
            <p>
                If you have a v1 or v2 license, you need to purchase a new license for version 3. It's a complete
                rewrite with native React, Vue and Angular packages, smoother touch, faster loading and
                <a href="/blog/lightgallery-v3/">new features</a>, while the 2.x API stays unchanged. If you purchased a
                license in the last 6 months, email us at <a href={`mailto:${EMAIL}`}>{EMAIL}</a> to get a license.
            </p>
        </div>
    </div>
</div>
