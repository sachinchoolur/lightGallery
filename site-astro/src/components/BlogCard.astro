---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

import {
    CONTRIBUTOR_IMAGES,
    SHORT_DATE_FORMAT,
    blogUrl,
    bundleImage,
    categoryOf,
    displayDate,
} from '../lib/blog';

/**
 * Post card for the blog index grid and the related posts under a post:
 * the header image in a soft frame, category and date, the title, and
 * the author with a small avatar.
 */
interface Props {
    entry: CollectionEntry<'blog'>;
    /** First card on the index: the LCP image, so load it eagerly. */
    eager?: boolean;
}

const { entry, eager = false } = Astro.props;
const url = blogUrl(entry);
const header = bundleImage(entry, 'header.png');
const author = entry.data.contributors[0];
const shown = displayDate(entry);
---

<article class="blog-card">
    <a href={url} class="blog-card-link">
        <div class="blog-card-media">
            {
                header && (
                    <Image
                        alt=""
                        src={header}
                        widths={[400, 800]}
                        sizes="(max-width: 639px) 100vw, (max-width: 1023px) 50vw, 340px"
                        format="webp"
                        loading={eager ? 'eager' : 'lazy'}
                        fetchpriority={eager ? 'high' : 'auto'}
                    />
                )
            }
        </div>
        <div class="blog-card-body">
            <div class="blog-card-meta">
                <span>{categoryOf(entry)}</span>
                {shown && <time datetime={shown.toISOString()}>{SHORT_DATE_FORMAT.format(shown)}</time>}
            </div>
            <h3 class="blog-card-title">{entry.data.title}</h3>
            {
                author && (
                    <div class="blog-card-author">
                        {CONTRIBUTOR_IMAGES[author] && (
                            <Image
                                src={CONTRIBUTOR_IMAGES[author]}
                                width={20}
                                height={20}
                                densities={[1, 2]}
                                format="webp"
                                alt=""
                            />
                        )}
                        <span>{author}</span>
                    </div>
                )
            }
        </div>
    </a>
</article>
