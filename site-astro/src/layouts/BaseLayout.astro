---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Metadata from '../components/Metadata.astro';
import type { ComponentProps } from 'astro/types';

// Variable web fonts: Inter for text, Roboto Serif italic for heading
// accents, Geist Mono for code and dark sections.
import '@fontsource-variable/inter';
import '@fontsource-variable/roboto-serif/wght-italic.css';
import '@fontsource-variable/geist-mono';
import '../styles/app.scss';
import 'lightgallery/css/lightgallery-bundle.css';
import 'lightgallery/css/lg-justified.css';
import 'lightgallery/css/lg-rtl.css';
import 'lightgallery/css/lg-transitions.css';

/**
 * Base page shell — port of `layouts/_default/baseof.html` + the head
 * partial chain. Body class mirrors Hugo's Kind/Type mapping
 * (`home`, `error404`, `docs single`, `demos list`, ...).
 *
 * Global JS is Bootstrap only (navbar collapse) plus PostHog analytics in
 * production. Deviations from the Hugo script-footer, by design: the
 * v2 lightGallery UMD bundle + carousel vendors are loaded per demo page
 * (not globally), lazysizes is replaced by native lazy loading, and the
 * dead Google Analytics (UA) tag is dropped.
 */
interface Props {
    bodyClass: string;
    meta: ComponentProps<typeof Metadata>;
}

const { bodyClass, meta } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta http-equiv="x-ua-compatible" content="ie=edge" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1, shrink-to-fit=no"
        />
        <Metadata {...meta} />
        <script is:inline>
            // Framework code tabs: apply the deep-linked or remembered
            // framework before first paint, so the panels never swap
            // once the deferred module runs. CodeTabs.astro takes over
            // (and drops the attribute) as soon as it has synced.
            (() => {
                const valid = ['vanilla', 'react', 'vue', 'angular'];
                const url = new URL(window.location.href);
                const query = url.searchParams.get('framework');
                const hash = url.hash.replace(/^#/, '');
                let framework = null;
                if (query && valid.includes(query)) framework = query;
                else if (valid.includes(hash)) framework = hash;
                else
                    try {
                        const stored = localStorage.getItem('lg-framework');
                        if (stored && valid.includes(stored)) framework = stored;
                    } catch {
                        /* storage blocked */
                    }
                if (framework)
                    document.documentElement.dataset.lgFramework = framework;
            })();
        </script>
        <slot name="head" />
        {
            import.meta.env.PROD && (
                <script
                    is:inline
                    set:html={`!function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.async=!0,p.src=s.api_host+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="capture identify alias people.set people.set_once set_config register register_once unregister opt_out_capturing has_opted_out_capturing opt_in_capturing reset isFeatureEnabled onFeatureFlags getFeatureFlag getFeatureFlagPayload reloadFeatureFlags group updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures getActiveMatchingSurveys getSurveys onSessionId".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);posthog.init('phc_uyDcoLpTSdtPcDLf2SswgknmWiBsUfV2EzjhzYi3Ke4',{api_host:'https://app.posthog.com'})`}
                />
            )
        }
    </head>
    <body class={bodyClass}>
        <Header />
        <slot />
        <Footer />
        <script>
            import 'bootstrap/dist/js/bootstrap.min.js';

            // Fixed-header treatment on scroll (app.js header, de-jQueryfied).
            window.addEventListener('scroll', () => {
                const fixed = window.scrollY > 50;
                document.body.classList.toggle('has-fixed-header', fixed);
                document
                    .getElementById('nav-header')
                    ?.classList.toggle('fixed-header', fixed);
            });
        </script>
    </body>
</html>
