---
import { getCollection } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';
import { DEMO_GROUPS as GROUPS, demoFramework as FRAMEWORK } from '../../lib/demo-groups';

/**
 * The /demos/ index, grouped by what a visitor is looking for rather
 * than one flat alphabetical list (the groups live in lib/demo-groups,
 * shared with the demo sidebar).
 */
const entries = await getCollection('demos');
const bySlug = new Map(
    entries.map((entry) => [entry.id.replace(/\/index$/, '').toLowerCase(), entry]),
);

const groups = GROUPS.map((group) => ({
    ...group,
    items: group.slugs
        .map((slug) => ({ slug, entry: bySlug.get(slug) }))
        .filter((item) => item.entry),
}));

const grouped = new Set(GROUPS.flatMap((group) => group.slugs));
const leftovers = [...bySlug.entries()]
    .filter(([slug]) => !grouped.has(slug))
    .map(([slug, entry]) => ({ slug, entry }))
    .sort((a, b) => a.entry!.data.title.localeCompare(b.entry!.data.title));
const all = leftovers.length
    ? [
          ...groups,
          { name: 'More demos', blurb: '', slugs: [], items: leftovers },
      ]
    : groups;
---

<BaseLayout
    bodyClass="demos list"
    meta={{
        title: `Demos: ${entries.length} JavaScript gallery examples`,
        description:
            'Live lightGallery demos: thumbnails, zoom, video, captions, carousels, React, justified layout and more, each with the code to copy.',
        breadcrumbs: [{ name: 'Demos', url: '/demos/' }],
    }}
>
    <div class="wrap container-xxl page-wrap" role="document">
        <div class="row justify-content-center">
            <div class="col-md-12 col-lg-10 col-xl-8">
                <article>
                    <h1 class="text-center">Demos</h1>
                    <div class="text-center"></div>
                    {
                        all.map((group) => (
                            <section class="demo-group">
                                <h2>{group.name}</h2>
                                {group.blurb && (
                                    <p class="demo-group-blurb">
                                        {group.blurb}
                                    </p>
                                )}
                                <div class="card-list">
                                    {group.items.map(({ slug, entry }) => (
                                        <div class="card my-3">
                                            <div class="card-body">
                                                <a
                                                    class="stretched-link"
                                                    href={`/demos/${slug}/`}
                                                >
                                                    {entry!.data.title} &rarr;
                                                </a>
                                                {FRAMEWORK(slug) && (
                                                    <span class="demo-badge">
                                                        {FRAMEWORK(slug)}
                                                    </span>
                                                )}
                                            </div>
                                        </div>
                                    ))}
                                </div>
                            </section>
                        ))
                    }
                </article>
            </div>
        </div>
    </div>
</BaseLayout>
