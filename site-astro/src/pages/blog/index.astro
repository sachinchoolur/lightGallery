---
import { Image } from 'astro:assets';
import { getCollection, getEntry } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import {
    CONTRIBUTOR_IMAGES,
    SHORT_DATE_FORMAT,
    blogUrl,
    bundleImage,
    categoryOf,
    displayDate,
} from '../../lib/blog';

/**
 * The blog index: the newest post as a two-column feature, header image
 * beside the title, then the rest as a card grid. Pagination becomes a
 * question past a few dozen posts.
 */
const blogIndex = await getEntry('pages', 'blog-index');
// Newest first by the date a post shows, so a refreshed post moves up.
const posts = (await getCollection('blog')).sort(
    (a, b) => (displayDate(b)?.valueOf() ?? 0) - (displayDate(a)?.valueOf() ?? 0),
);
const [featured, ...rest] = posts;
const featuredImage = featured ? bundleImage(featured, 'header.png') : undefined;
const featuredAuthor = featured?.data.contributors[0];
---

<BaseLayout
    bodyClass="blog list"
    meta={{
        title: blogIndex?.data.title ?? 'Blog',
        description: blogIndex?.data.description,
    }}
>
    <div class="post-page">
        <div class="post-frame">
            <h1 class="visually-hidden">Blog</h1>
            {
                featured && (
                    <a class="blog-featured" href={blogUrl(featured)}>
                        <div class="blog-featured-media">
                            {featuredImage && (
                                <Image
                                    alt=""
                                    src={featuredImage}
                                    widths={[640, 1080]}
                                    sizes="(max-width: 767px) 100vw, 520px"
                                    format="webp"
                                    loading="eager"
                                    fetchpriority="high"
                                />
                            )}
                        </div>
                        <div class="blog-featured-body">
                            <div class="blog-card-meta">
                                <span>{categoryOf(featured)}</span>
                                {displayDate(featured) && (
                                    <time datetime={displayDate(featured)!.toISOString()}>
                                        {SHORT_DATE_FORMAT.format(displayDate(featured)!)}
                                    </time>
                                )}
                            </div>
                            <h2 class="blog-featured-title">{featured.data.title}</h2>
                            <p class="blog-featured-lead">{featured.data.description}</p>
                            {featuredAuthor && (
                                <div class="blog-featured-author">
                                    {CONTRIBUTOR_IMAGES[featuredAuthor] && (
                                        <Image
                                            src={CONTRIBUTOR_IMAGES[featuredAuthor]}
                                            width={24}
                                            height={24}
                                            densities={[1, 2]}
                                            format="webp"
                                            alt=""
                                        />
                                    )}
                                    <span>{featuredAuthor}</span>
                                </div>
                            )}
                        </div>
                    </a>
                )
            }
            <div class="blog-grid blog-grid-index">
                {rest.map((entry) => <BlogCard entry={entry} />)}
            </div>
        </div>
    </div>
</BaseLayout>
