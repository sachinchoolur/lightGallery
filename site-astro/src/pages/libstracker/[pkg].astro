---
/**
 * The per-package pages of the tracker ("list of websites using jquery"),
 * one raw-HTML Hugo page per package, rendered like the index.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadToolPage } from '../../lib/tools';

export function getStaticPaths() {
    const files = import.meta.glob('../../../../site/content/libstracker/*/index.html', {
        query: '?raw',
        import: 'default',
        eager: true,
    }) as Record<string, string>;
    return Object.entries(files).map(([file, raw]) => ({
        params: { pkg: file.split('/').at(-2) },
        props: { page: loadToolPage(raw) },
    }));
}

const { page } = Astro.props;
// The Hugo titles read "list of websites using jquery."; the tab and the
// search snippet want a sentence case title without the full stop.
const title = page.title.replace(/\.$/, '').replace(/^\w/, (c) => c.toUpperCase());
---

<BaseLayout
    bodyClass="libstracker single"
    meta={{
        title,
        description: page.description,
        images: ['/libstracker/banner.png'],
    }}
>
    <Fragment set:html={page.body} />
</BaseLayout>
