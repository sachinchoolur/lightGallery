---
import { getCollection, render } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';

/** /changelog/ — the repo's CHANGELOG.md, one source of truth. */
const [entry] = await getCollection('changelog');
if (!entry) throw new Error('CHANGELOG.md not found (site-astro/../CHANGELOG.md)');
const { Content } = await render(entry);
---

<BaseLayout
    bodyClass="docs single changelog"
    meta={{
        title: 'Changelog',
        description:
            'What changed in each lightGallery release — new features, changed defaults and removals, with links to the docs.',
        breadcrumbs: [{ name: 'Changelog', url: '/changelog/' }],
    }}
>
    <Fragment slot="head">
        <link rel="alternate" type="text/markdown" href="/changelog/index.md" title="Markdown version" />
    </Fragment>
    <div class="container-xl docs-content changelog-page">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <Content />
            </div>
        </div>
    </div>
</BaseLayout>

<style>
    .changelog-page {
        padding: 7rem 0 5rem;
    }
</style>
