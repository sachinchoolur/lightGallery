---
import { getEntry, render } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';
import HeroTopBox from '../components/kelviq/HeroTopBox.astro';
import PrimaryButton from '../components/kelviq/PrimaryButton.astro';
import SecondaryButton from '../components/kelviq/SecondaryButton.astro';

/**
 * Homepage rework candidate — a clone of `index.astro` + `pages/home`
 * with the v3 story on it (stack switcher, numbers, feature grid,
 * physics, perf), served side by side with the live homepage for
 * review. Not indexed and not in the sitemap until it replaces `/`.
 */
const home = await getEntry('pages', 'home-v3');
if (!home) throw new Error('pages/home-v3.mdx missing');
const { Content } = await render(home);
---

<BaseLayout
    bodyClass="home home-v3"
    meta={{
        title: home.data.title,
        description: home.data.description,
        isHome: true,
        robots: 'noindex, nofollow',
        software: {
            name: 'lightGallery',
            description: home.data.description,
        },
    }}
>
    <div class="home-hero-band">
        <div class="container-xl home-hero">
            <div class="home-hero-decor" aria-hidden="true"><HeroTopBox /></div>
            <div class="home-hero-inner">
                <h1 class="main-title">{home.data.title}</h1>
                <p class="para1 home-hero-lead" set:html={home.data.lead ?? ''} />
                <div class="hero-actions">
                    <PrimaryButton
                        href="/docs/getting-started/"
                        data-stack-cta
                        data-href-vanilla="/docs/getting-started/"
                        data-href-react="/docs/react/"
                        data-href-vue="/docs/vue/"
                        data-href-angular="/docs/angular/"
                    >
                        Get started
                    </PrimaryButton>
                    <SecondaryButton href="https://github.com/sachinchoolur/lightGallery" rel="noopener">
                        View on GitHub
                    </SecondaryButton>
                </div>
            </div>
        </div>
    </div>
    <Content />
    <script>
        // The page follows the visitor's stack: the hero CTA and the
        // closing per-stack buttons track the framework the code tabs
        // remember (the same localStorage key CodeTabs.astro uses), and
        // update when a tab is clicked.
        const LABELS: Record<string, string> = {
            vanilla: 'Get started',
            react: 'Get started with React',
            vue: 'Get started with Vue',
            angular: 'Get started with Angular',
        };

        function current(): string {
            try {
                return localStorage.getItem('lg-framework') ?? 'vanilla';
            } catch {
                return 'vanilla';
            }
        }

        function follow(framework: string) {
            document
                .querySelectorAll<HTMLAnchorElement>('[data-stack-cta]')
                .forEach((cta) => {
                    const href = cta.dataset[`href${framework[0].toUpperCase()}${framework.slice(1)}`];
                    if (href) cta.href = href;
                    const label = cta.querySelector('.kq-btn-label') ?? cta;
                    label.textContent = LABELS[framework] ?? LABELS.vanilla;
                });
            document
                .querySelectorAll<HTMLAnchorElement>('.home-cta-actions a')
                .forEach((link) => {
                    const on = link.dataset.framework === framework;
                    link.classList.toggle('btn-primary', on);
                    link.classList.toggle('btn-outline-primary', !on);
                });
        }

        follow(current());
        document.addEventListener('click', (event) => {
            const tab = (event.target as HTMLElement).closest<HTMLElement>('.code-tabs-tab');
            if (tab?.dataset.framework) follow(tab.dataset.framework);
        });
    </script>
</BaseLayout>
