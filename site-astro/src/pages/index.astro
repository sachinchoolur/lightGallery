---
import { getEntry, render } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';
import HeroTopBox from '../components/ds/HeroTopBox.astro';
import PrimaryButton from '../components/ds/PrimaryButton.astro';
import SecondaryButton from '../components/ds/SecondaryButton.astro';

/**
 * The homepage (`pages/home`): hero + gallery, stack switcher, feature
 * grid, gestures and motion, customization, inline gallery, FAQ, CTA.
 * The previous homepage is kept at /home-v2/ for reference.
 */
const home = await getEntry('pages', 'home');
if (!home) throw new Error('pages/home.mdx missing');
const { Content } = await render(home);

const GITHUB_PATH =
    'M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12';
---

<BaseLayout
    bodyClass="home home-v3"
    meta={{
        title: home.data.title,
        description: home.data.description,
        isHome: true,
        software: {
            name: 'lightGallery',
            description: home.data.description,
        },
    }}
>
    <div class="home-hero-band">
        <div class="container-xl home-hero">
            <div class="home-hero-decor" aria-hidden="true"><HeroTopBox /></div>
            <div class="home-hero-inner">
                <span class="home-hero-pill"><i aria-hidden="true" />lightGallery v3</span>
                <h1 class="main-title">Gallery that feels <span class="serif-accent">native</span></h1>
                <p class="para1 home-hero-lead" set:html={home.data.lead ?? ''} />
                <div class="hero-actions">
                    <PrimaryButton
                        href="/docs/getting-started/"
                        data-stack-cta
                        data-href-vanilla="/docs/getting-started/"
                        data-href-react="/docs/react/"
                        data-href-vue="/docs/vue/"
                        data-href-angular="/docs/angular/"
                    >
                        Get started
                    </PrimaryButton>
                    <SecondaryButton href="https://github.com/sachinchoolur/lightGallery" rel="noopener">
                        <svg class="home-hero-github" viewBox="0 0 24 24" aria-hidden="true"><path d={GITHUB_PATH} /></svg>
                        View on GitHub
                    </SecondaryButton>
                </div>
            </div>
        </div>
    </div>
    <Content />
    <script>
        // The page follows the visitor's stack: the hero CTA and the
        // closing stack tiles track the framework the code tabs remember
        // (the same localStorage key CodeTabs.astro uses), and update when
        // a tab is clicked.
        const LABELS: Record<string, string> = {
            vanilla: 'Get started',
            react: 'Get started with React',
            vue: 'Get started with Vue',
            angular: 'Get started with Angular',
        };

        function current(): string {
            try {
                return localStorage.getItem('lg-framework') ?? 'vanilla';
            } catch {
                return 'vanilla';
            }
        }

        function follow(framework: string) {
            document
                .querySelectorAll<HTMLAnchorElement>('[data-stack-cta]')
                .forEach((cta) => {
                    const href = cta.dataset[`href${framework[0].toUpperCase()}${framework.slice(1)}`];
                    if (href) cta.href = href;
                    const label = cta.querySelector('.kq-btn-label') ?? cta;
                    label.textContent = LABELS[framework] ?? LABELS.vanilla;
                });
            document
                .querySelectorAll<HTMLAnchorElement>('.home-cta-actions a')
                .forEach((link) => {
                    link.classList.toggle('is-current', link.dataset.framework === framework);
                });
        }

        follow(current());
        document.addEventListener('click', (event) => {
            const tab = (event.target as HTMLElement).closest<HTMLElement>('.code-tabs-tab');
            if (tab?.dataset.framework) follow(tab.dataset.framework);
        });
    </script>
</BaseLayout>
